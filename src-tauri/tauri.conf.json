{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "StudyVault",
  "version": "0.9.0",
  "identifier": "com.studyvault.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "StudyVault",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' http://localhost:1234 http://localhost:5055 http://localhost:8000 http://localhost:8100 http://localhost:11434 ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "StudyVault",
    "copyright": "© StudyVault contributors. Personal use only.",
    "category": "Education",
    "shortDescription": "Local-first CFA · Quant · Excel · LSAT exam-prep desktop app.",
    "longDescription": "StudyVault turns your own curriculum into a fully-offline study OS across CFA, Quant, Excel and the LSAT: spaced repetition, generative mock exams, grounded-RAG Q&A, blind review, adaptive drills, multimodal AI coaching, and analytics. Everything runs on your machine — no cloud, no API keys, no telemetry.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/services": "resources/services"
    },
    "externalBin": [],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "tsp": false,
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["English"],
        "installMode": "perMachine",
        "compression": "lzma"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
