{
  "name": "quantvault",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=dist/reports/junit.xml",
    "verify": "npm run lint && npm run test && npm run build",
    "audit": "npm audit --omit=dev",
    "content:validate": "node --import ./scripts/register-ts-loader.mjs scripts/content-validate.mjs",
    "content:report": "node --import ./scripts/register-ts-loader.mjs scripts/content-report.mjs",
    "bundle:report": "node scripts/bundle-report.mjs",
    "smoke": "node --import ./scripts/register-ts-loader.mjs scripts/smoke.mjs",
    "browser:regression": "node scripts/browser-regression.mjs",
    "visual:regression": "node --import ./scripts/register-ts-loader.mjs scripts/visual-regression.mjs",
    "a11y:check": "node --import ./scripts/register-ts-loader.mjs scripts/a11y-check.mjs",
    "fresh-import:check": "node --import ./scripts/register-ts-loader.mjs scripts/fresh-import-check.mjs",
    "release:gates": "node --import ./scripts/register-ts-loader.mjs scripts/release-gates.mjs",
    "release:checklist": "node --import ./scripts/register-ts-loader.mjs scripts/release-checklist.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.59.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "dexie": "^4.4.2",
    "katex": "^0.16.45",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1"
  }
}
