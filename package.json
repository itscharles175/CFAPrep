{
  "name": "studyvault",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run --project host",
    "test:lsat": "vitest run --project lsat",
    "test:all": "vitest run",
    "test:watch": "vitest --project host",
    "test:ci": "vitest run --project host --reporter=default --reporter=junit --outputFile=dist/reports/junit.xml",
    "test:lsat:ci": "vitest run --project lsat --reporter=default --reporter=junit --outputFile=dist/reports/junit-lsat.xml",
    "typecheck:lsat": "tsc -p tsconfig.lsat.json",
    "verify": "npm run lint && npm run test && npm run build",
    "audit": "npm audit --omit=dev",
    "content:validate": "node --import ./scripts/register-ts-loader.mjs scripts/content-validate.mjs",
    "content:report": "node --import ./scripts/register-ts-loader.mjs scripts/content-report.mjs",
    "content:expand": "node scripts/content-expand.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug",
    "build:onb-binary": "node scripts/build-onb-binary.mjs",
    "build:lsat-binary": "node scripts/build-lsat-binary.mjs",
    "cfa:source:inventory": "node scripts/cfa-source-vault.mjs inventory",
    "cfa:source:ingest": "node scripts/cfa-source-vault.mjs ingest",
    "cfa:source:bundle": "node scripts/cfa-source-vault.mjs bundle",
    "cfa:source:coverage": "node scripts/cfa-source-vault.mjs coverage",
    "cfa:source:audit": "node scripts/cfa-source-vault.mjs audit",
    "cfa:source:install": "node scripts/install-source-bundle.mjs",
    "bundle:report": "node scripts/bundle-report.mjs",
    "smoke": "node --import ./scripts/register-ts-loader.mjs scripts/smoke.mjs",
    "browser:regression": "node --import ./scripts/register-ts-loader.mjs scripts/browser-regression.mjs",
    "visual:regression": "node --import ./scripts/register-ts-loader.mjs scripts/visual-regression.mjs",
    "a11y:check": "node --import ./scripts/register-ts-loader.mjs scripts/a11y-check.mjs",
    "fresh-import:check": "node --import ./scripts/register-ts-loader.mjs scripts/fresh-import-check.mjs",
    "gen:api": "node scripts/export-lsat-openapi.mjs --write-client && npx --yes openapi-typescript@7 src/domains/lsat/_meta/openapi.json -o src/domains/lsat/lib/api.gen.ts",
    "contract:check:client": "node scripts/export-lsat-openapi.mjs --client",
    "check:versions": "node scripts/check-version-sync.mjs",
    "check:no-egress": "node scripts/check-no-egress.mjs",
    "check:docs": "node scripts/check-docs-drift.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.8.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.59.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.10",
    "@hookform/resolvers": "^5.4.0",
    "@huggingface/transformers": "^3.8.1",
    "@radix-ui/react-accordion": "^1.2.13",
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-progress": "^1.1.9",
    "@radix-ui/react-radio-group": "^1.4.0",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slider": "^1.4.0",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-toggle": "^1.1.11",
    "@radix-ui/react-toggle-group": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-virtual": "^3.14.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@visx/axis": "^4.0.0",
    "@visx/gradient": "^4.0.0",
    "@visx/grid": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/heatmap": "^4.0.0",
    "@visx/pattern": "^4.0.0",
    "@visx/responsive": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "@visx/tooltip": "^4.0.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "dexie": "^4.4.2",
    "html-to-image": "^1.11.13",
    "katex": "^0.16.45",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^1.14.0",
    "motion": "^12.40.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.79.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "surrealdb": "^1.3.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "ts-fsrs": "^5.4.1",
    "zod": "^4.4.3"
  }
}
