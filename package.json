{
  "name": "quantvault",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=dist/reports/junit.xml",
    "verify": "npm run lint && npm run test && npm run build",
    "audit": "npm audit --omit=dev",
    "content:validate": "node --import ./scripts/register-ts-loader.mjs scripts/content-validate.mjs",
    "content:report": "node --import ./scripts/register-ts-loader.mjs scripts/content-report.mjs",
    "content:expand": "node scripts/content-expand.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug",
    "build:onb-binary": "node scripts/build-onb-binary.mjs",
    "cfa:source:inventory": "node scripts/cfa-source-vault.mjs inventory",
    "cfa:source:ingest": "node scripts/cfa-source-vault.mjs ingest",
    "cfa:source:bundle": "node scripts/cfa-source-vault.mjs bundle",
    "cfa:source:coverage": "node scripts/cfa-source-vault.mjs coverage",
    "cfa:source:audit": "node scripts/cfa-source-vault.mjs audit",
    "cfa:source:install": "node scripts/install-source-bundle.mjs",
    "bundle:report": "node scripts/bundle-report.mjs",
    "smoke": "node --import ./scripts/register-ts-loader.mjs scripts/smoke.mjs",
    "browser:regression": "node --import ./scripts/register-ts-loader.mjs scripts/browser-regression.mjs",
    "visual:regression": "node --import ./scripts/register-ts-loader.mjs scripts/visual-regression.mjs",
    "a11y:check": "node --import ./scripts/register-ts-loader.mjs scripts/a11y-check.mjs",
    "fresh-import:check": "node --import ./scripts/register-ts-loader.mjs scripts/fresh-import-check.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.59.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "dexie": "^4.4.2",
    "katex": "^0.16.45",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^1.14.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "surrealdb": "^1.3.2",
    "ts-fsrs": "^5.4.1"
  }
}
