{
  "//": "Type-checks the vendored LSAT subtree on its own (it was authored for TS 5.6 + React 18; the host's strict tsc excludes it). Run: `npx tsc -p tsconfig.lsat.json`. Bundler resolution mirrors Vite; the host's `@lsat`/`@` aliases are reproduced here.",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@lsat/*": ["src/domains/lsat/*"],
      "@/*": ["src/*"]
    }
  },
  "include": ["src/domains/lsat"]
}
