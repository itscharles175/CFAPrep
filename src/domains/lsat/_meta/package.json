  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "gen:api:dump": "cd ../backend && uv run python -c \"import json,app.main as m; print(json.dumps(m.app.openapi()))\" > ../frontend/openapi.json",
    "gen:api": "npm run gen:api:dump && openapi-typescript openapi.json -o src/lib/api.gen.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
