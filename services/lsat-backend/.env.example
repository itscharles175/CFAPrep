# LSAT Lab — backend env vars (all optional; defaults work for local dev).
# Copy to backend/.env and uncomment / fill in as needed. NEVER commit .env.

# --- Storage ---------------------------------------------------------------
# LSATLAB_DB=backend/lsatlab.db
# LSATLAB_LOG_DIR=                 # defaults to <db dir>/logs
# LSATLAB_LOG_LEVEL=INFO
# Base64 32-byte AES-GCM key for selected local-only SQLite text fields. The
# packaged Electron main process owns this via OS-backed safeStorage
# and passes it to the sidecar; set manually only for local encryption testing.
# LSATLAB_DB_KEY_B64=

# --- Local model runtime ---------------------------------------------------
# Selects the local inference provider for realtime (explain/diagnose/tag),
# embeddings, and the local branch of offline generation. Also switchable at
# runtime from Settings -> AI & system (persisted), so you rarely need this var.
# LSATLAB_LOCAL_PROVIDER=ollama                # ollama | lmstudio
# LSATLAB_OLLAMA_URL=http://localhost:11434       # loopback unless both remote opt-outs below are set
# LMStudio's OpenAI-compatible base URL — INCLUDE the /v1 suffix. Loopback only
# unless BOTH LSATLAB_ENFORCE_OFFLINE=0 and LSATLAB_ALLOW_REMOTE_LLM=1 are set
# (realtime AI sends official content here, so by default it must stay on-device).
# LSATLAB_LMSTUDIO_URL=http://localhost:1234/v1
# LSATLAB_ALLOW_REMOTE_LLM=0                   # 1 = allow non-loopback local-model URLs only after LSATLAB_ENFORCE_OFFLINE=0
# LSATLAB_EXPLAIN_MODEL=phi4:14b
# LSATLAB_EXPLAIN_FALLBACK_MODEL=qwen3:8b      # used when preferred explain model is absent
# LSATLAB_GEN_MODEL=qwen3:14b
# LSATLAB_GEN_CRITIC_MODEL=llama3.1:8b         # decorrelate from GEN_MODEL
# LSATLAB_DIAGNOSE_MODEL=qwen3:8b
# LSATLAB_TAG_MODEL=qwen3:8b                   # A9 tag routing
# LSATLAB_EMBED_MODEL=nomic-embed-text
# LSATLAB_EMBED_REQUEST_TIMEOUT_S=30           # B22

# --- Generation gate -------------------------------------------------------
# LSATLAB_GEN_SC_RUNS=3
# LSATLAB_GEN_PROVIDER=ollama                  # ollama | cloud
# LSATLAB_LLM_RETRIES=2
# LSATLAB_LLM_CONCURRENCY=2
# LSATLAB_JOBS_WORKER=1                        # 0 in tests
# LSATLAB_SCHEDULER_TICK_SECONDS=3600          # <=0 disables due scheduled-task polling

# --- Optional cloud Tier-B (offline only; never realtime) ------------------
# ANTHROPIC_API_KEY=                           # or LSATLAB_CLOUD_API_KEY
# LSATLAB_ENFORCE_OFFLINE=0                    # required to opt out of packaged local-only fence
# LSATLAB_CLOUD_EGRESS_ALLOWED=0               # set 1 only when outbound model traffic is intentional
# LSATLAB_CLOUD_GEN_MODEL=claude-3-5-sonnet-20241022
# LSATLAB_CLOUD_MONTHLY_BUDGET_USD=50

# --- HTTP / CORS -----------------------------------------------------------
# LSATLAB_CORS_ORIGINS=http://localhost:5173,app://studyvault
# Optional local API token. Empty preserves unauthenticated local dev; when set,
# callers must send Authorization: Bearer <token> (or X-LSATLAB-API-Token) on
# non-health /api routes. The packaged Electron supervisor generates this per run;
# set it manually only for local auth-mode testing.
# LSATLAB_LOCAL_API_TOKEN=
# Sidecar bind host/port (read by sidecar_main.py). Non-loopback hosts require
# LSATLAB_ALLOW_REMOTE_API=1. Note: the packaged desktop app effectively pins the
# port to 8000 (the Electron service specification fixes this local port).
# LSATLAB_HOST=127.0.0.1
# LSATLAB_PORT=8000

# --- Vector backend (H1) ---------------------------------------------------
# LSATLAB_VECTOR_BACKEND=auto                  # auto | sqlite_vec | python

# --- Calibration / observability ------------------------------------------
# LSATLAB_CALIBRATION_INTERVAL_S=86400         # daily empirical-difficulty
# LSATLAB_SQLITE_FK_ENFORCE=0                  # B10: see config.py docstring
